<script id="workq-board">
/* This page is interactive by design: the HTML-state contract's "no script but the data block"
   does not apply. It only reads workq-state; nothing here writes to workq. The pure functions
   are exported on globalThis.workqBoard so test_workq_board.py can run them under node. */
(function(){
const STATUSES=["open","running","done","dropped"];
const COLOUR={open:"var(--open)",running:"var(--run)",done:"var(--done)",dropped:"var(--drop)"};
const VERB={open:"reopen",running:"start",done:"done",dropped:"drop"};
const esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const oneLine=s=>String(s).replace(/\s+/g," ").trim();
const chip=s=>`<span class="chip s-${s}"><span class="dot"></span>${s}</span>`;
function ageText(seconds){seconds=Math.max(0,Math.floor(seconds));
 for(const [unit,size] of [["d",86400],["h",3600],["m",60]])if(seconds>=size)return `${Math.floor(seconds/size)}${unit}`;
 return `${seconds}s`;}
function initialState(snapshot){
 return {order:snapshot.items.map(i=>i.n),status:Object.fromEntries(snapshot.items.map(i=>[i.n,i.status])),comments:{}};}
function resolve(snapshot,edited){
 const byN=new Map(snapshot.items.map(i=>[i.n,i]));
 return edited.order.map(n=>({...byN.get(n),was:byN.get(n).status,status:edited.status[n]}));}
function itemHTML(it,position,comments,tab,generatedAt){
 const age=ageText(generatedAt-it.t);
 const reason=it.was!==it.status?"":it.note?`Done note: ${esc(it.note)}`:it.why?`Dropped: ${esc(it.why)}`:"";
 const pane={
  details:`${reason||`Position ${position} in the queue.`}`,
  comments:comments.map(c=>`<div class="comment">${esc(c)}</div>`).join("")+`<div class="compose"><input placeholder="Comment for the agent" aria-label="Comment on #${it.n}" data-cin="${it.n}"><button data-cadd="${it.n}">Add</button></div>`,
  history:`<span class="muted">added ${age} ago${it.m?` from ${esc(it.m)}`:""}${it.status!=="open"?` · ${it.status}`:""}</span>`}[tab];
 return `<article class="item" style="--c:${COLOUR[it.status]}" data-n="${it.n}">
  <div class="row spread"><div class="row"><span class="handle" title="drag to reorder" data-drag="${it.n}">⠿</span><b>#${it.n}</b>${chip(it.status)}${it.m?`<span class="chip">from ${esc(it.m)}</span>`:""}<span class="chip">${age}</span>${comments.length?`<span class="chip">💬 ${comments.length}</span>`:""}</div>
   <div class="row"><button data-up="${it.n}" aria-label="move #${it.n} up">↑</button><button data-down="${it.n}" aria-label="move #${it.n} down">↓</button></div></div>
  <p class="text">${esc(it.text)}</p>
  <div class="stepper">${STATUSES.map(s=>`<button class="${it.status===s?"on":""}" data-set="${it.n}" data-s="${s}">${s}</button>`).join("")}</div>
  <div class="tabs" role="tablist">${["details","comments","history"].map(t=>`<button role="tab" aria-selected="${tab===t}" data-tab="${it.n}" data-t="${t}">${t[0].toUpperCase()+t.slice(1)}${t==="comments"&&comments.length?` (${comments.length})`:""}</button>`).join("")}</div>
  <div class="pane">${pane}</div>
 </article>`;}
function viewHTML(snapshot,edited=initialState(snapshot),tabs={}){
 const items=resolve(snapshot,edited);
 const live=items.filter(i=>i.status==="open"||i.status==="running"),closed=items.filter(i=>i.status==="done"||i.status==="dropped");
 const card=it=>itemHTML(it,items.indexOf(it)+1,edited.comments[it.n]||[],tabs[it.n]||"details",snapshot.generated_at);
 const lane=(title,list)=>`<p class="lane-title">${title}</p><div class="list">${list.map(card).join("")||'<p class="muted">—</p>'}</div>`;
 return `<div class="card">${lane("Now",live.slice(0,1))}${lane("Next",live.slice(1,3))}${lane("Later",live.slice(3))}<details style="margin-top:.6rem"><summary class="muted">Closed (${closed.length})</summary><div class="list" style="margin-top:.5rem">${closed.map(card).join("")}</div></details></div>`;}
/* Fewest `workq move` commands that turn the original order into the edited one: items on a
   longest increasing subsequence keep their place; every other item is re-anchored after its
   new predecessor, walking the edited order front to back. */
function moveCommands(original,order){
 const rank=new Map(order.map((n,i)=>[n,i])),ranks=original.map(n=>rank.get(n));
 const length=ranks.map(()=>1),previous=ranks.map(()=>-1);let best=-1;
 ranks.forEach((r,i)=>{for(let j=0;j<i;j++)if(ranks[j]<r&&length[j]+1>length[i]){length[i]=length[j]+1;previous[i]=j;}
  if(best<0||length[i]>length[best])best=i;});
 const keep=new Set();for(let i=best;i>=0;i=previous[i])keep.add(original[i]);
 return order.flatMap((n,i)=>keep.has(n)?[]:[`workq move ${n} --after ${i?order[i-1]:0}`]);}
function changeCommands(snapshot,edited){
 const lines=[];
 snapshot.items.forEach(it=>{const now=edited.status[it.n];
  if(now!==it.status)lines.push(`workq ${VERB[now]} ${it.n}${now==="dropped"?" --why 'dropped on the board'":""}`);});
 lines.push(...moveCommands(snapshot.items.map(i=>i.n),edited.order));
 /* One physical line per comment: a newline would let the next line run as a command. */
 Object.keys(edited.comments).forEach(n=>edited.comments[n].forEach(c=>{const text=oneLine(c);if(text)lines.push(`# comment on #${n}: ${text}`);}));
 return lines.length?lines:["# no changes"];}
function stateText(snapshot,edited){return JSON.stringify({workq:1,order:edited.order,status:edited.status,comments:edited.comments},null,1);}
/* Takes order, status and comments from a pasted state; never item text. Null when the state
   is not a copy of this queue. */
function restoreState(snapshot,text){
 try{const s=JSON.parse(text),known=snapshot.items.map(i=>i.n);
  if(!s||s.workq!==1||!Array.isArray(s.order))return null;
  if(new Set(s.order).size!==known.length||!s.order.every(n=>known.includes(n)))return null;
  if(!known.every(n=>s.status&&STATUSES.includes(s.status[n])))return null;
  const comments={};
  Object.entries(s.comments||{}).forEach(([n,list])=>{if(known.includes(+n)&&Array.isArray(list))comments[n]=list.map(String);});
  return {order:s.order.slice(),status:Object.fromEntries(known.map(n=>[n,s.status[n]])),comments};
 }catch(error){return null;}}
globalThis.workqBoard={viewHTML,initialState,changeCommands,stateText,restoreState};
if(typeof document==="undefined")return;

const snapshot=JSON.parse(document.getElementById("workq-state").textContent);
let edited=initialState(snapshot),tabs={};
const $=id=>document.getElementById(id);
function render(){
 const drafts=[...document.querySelectorAll("[data-cin]")].map(i=>[i.dataset.cin,i.value]);
 const items=resolve(snapshot,edited),by=s=>items.filter(i=>i.status===s);
 $("counts").textContent=STATUSES.map(s=>`${by(s).length} ${s}`).join(" · ");
 $("strip").innerHTML=items.length?["done","running","open","dropped"].map(s=>`<span style="width:${100*by(s).length/items.length}%;background:${COLOUR[s]}"></span>`).join(""):"";
 $("asof").textContent=`As of ${new Date(snapshot.generated_at*1000).toLocaleTimeString([],{hour:"2-digit",minute:"2-digit"})}. Edits stay on this page until you hand them back.`;
 $("view").innerHTML=items.length?viewHTML(snapshot,edited,tabs):'<p class="card muted">The queue is empty.</p>';
 drafts.forEach(([n,value])=>{const input=document.querySelector(`[data-cin="${n}"]`);if(input)input.value=value;});}
function isLive(n){return edited.status[n]==="open"||edited.status[n]==="running";}
function move(n,step){
 const group=m=>isLive(m)===isLive(n),order=edited.order;
 for(let j=order.indexOf(n)+step;j>=0&&j<order.length;j+=step)if(group(order[j])){
  order.splice(order.indexOf(n),1);order.splice(j,0,n);break;}
 render();}
document.addEventListener("click",e=>{const b=e.target.closest("button");if(!b)return;const d=b.dataset;
 if(d.tab){tabs[d.tab]=d.t;render();}
 else if(d.up)move(+d.up,-1);else if(d.down)move(+d.down,1);
 else if(d.set){edited.status[d.set]=d.s;render();}
 else if(d.cadd){const input=document.querySelector(`[data-cin="${d.cadd}"]`),text=oneLine(input.value);
  if(text){(edited.comments[d.cadd]=edited.comments[d.cadd]||[]).push(text);tabs[d.cadd]="comments";render();}}});
document.addEventListener("keydown",e=>{if(e.key==="Enter"&&e.target.dataset.cin)document.querySelector(`[data-cadd="${e.target.dataset.cin}"]`).click();});
/* pointer drag: works with touch, unlike HTML5 drag and drop. The dragged item takes the target's slot. */
let drag=null;
document.addEventListener("pointerdown",e=>{const h=e.target.closest("[data-drag]");if(!h)return;
 drag={n:+h.dataset.drag,el:h.closest(".item")};drag.el.classList.add("dragging");h.setPointerCapture(e.pointerId);});
function endDrag(e,drop){if(!drag)return;drag.el.classList.remove("dragging");
 const target=drop&&document.elementsFromPoint(e.clientX,e.clientY).map(x=>x.closest&&x.closest(".item")).find(x=>x&&+x.dataset.n!==drag.n);
 if(target){const order=edited.order,slot=order.indexOf(+target.dataset.n);order.splice(order.indexOf(drag.n),1);order.splice(slot,0,drag.n);}
 drag=null;render();}
document.addEventListener("pointerup",e=>endDrag(e,true));
document.addEventListener("pointercancel",e=>endDrag(e,false));
function flash(text){$("toast").textContent=text;setTimeout(()=>$("toast").textContent="",3000);}
function show(text,label){const out=$("out");out.value=text;out.select();
 let copied=null;try{copied=navigator.clipboard&&navigator.clipboard.writeText(text);}catch(error){}
 if(copied)copied.then(()=>flash(`${label} (copied)`),()=>flash(`${label}: clipboard blocked, copy the text below`));
 else flash(`${label}: copy the text below`);}
$("copyChanges").onclick=()=>show(changeCommands(snapshot,edited).join("\n"),"Changes");
$("copyState").onclick=()=>show(stateText(snapshot,edited),"State");
$("pasteState").onclick=()=>{const restored=restoreState(snapshot,$("out").value);
 if(restored){edited=restored;render();flash("State restored");}else flash("That is not a copied state of this queue");};
render();
})();
</script>
<script>
(function(){var last=0;function send(){var h=Math.ceil(document.documentElement.getBoundingClientRect().height);
if(h!==last){last=h;parent.postMessage({jsonrpc:"2.0",method:"ui/notifications/size-changed",params:{height:h}},"*");}}
new ResizeObserver(send).observe(document.documentElement);document.addEventListener("toggle",send,true);send();})();
</script>
</body></html>
"""


def snapshot(queue, now):
    """CLAIM(board-snapshot): every item in queue order, closing reasons included [test_workq_board]."""
    items = [{"n": n, "order": position, **{key: queue.items[n][key] for key in
              ("text", "m", "status", "note", "why", "t")}}
             for position, n in enumerate(queue.order, 1)]
    return {"workq": 1, "generated_at": now, "items": items}


def state_block(value):
    """JSON safe inside a <script>: no raw '<' can open '</script>' or '<!--'."""
    return (json.dumps(value, ensure_ascii=False)
            .replace("<", "\\u003c").replace(">", "\\u003e").replace("&", "\\u0026"))


def board_summary(board):
    counts = {status: 0 for status in ("open", "running", "done", "dropped")}
    for item in board["items"]:
        counts[item["status"]] += 1
    lines = [" · ".join(f"{counts[status]} {status}" for status in counts)]
    return lines + [item_line(item) for item in board["items"]]


def write_board_page(path, board):
    page = BOARD_PAGE.replace("__WORKQ_STATE__", state_block(board))
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
        stream.write(page)


def parser():
    arguments = argparse.ArgumentParser(description=__doc__)
    arguments.add_argument("-s", "--session")
    commands = arguments.add_subparsers(dest="command", required=True)
    for command in ("on", "off"):
        commands.add_parser(command)
    add = commands.add_parser("add")
    add.add_argument("--from", dest="source")
    add.add_argument("text", nargs="+")
    listing = commands.add_parser("list")
    listing.add_argument("--all", action="store_true")
    board = commands.add_parser("board", help="read-only snapshot of the queue, optionally as a page")
    board.add_argument("--json", action="store_true")
    board.add_argument("--html", metavar="PATH")
    for command in ("start", "done", "drop", "reopen", "move", "nothing"):
        sub = commands.add_parser(command)
        sub.add_argument("number")
        if command == "done":
            sub.add_argument("--note")
        if command in ("drop", "nothing"):
            sub.add_argument("--why", required=True)
        if command == "move":
            sub.add_argument("--after", required=True)
    return arguments


def main():
    args = parser().parse_args()
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID") or args.session or os.environ.get("WORKQ_SESSION")
    try:
        if not sid:
            raise OSError("set CLAUDE_CODE_SESSION_ID, -s, or WORKQ_SESSION")
        with queue_for(sid, create=args.command == "on") as queue:
            command = args.command
            if command in ("on", "off"):
                queue.record(command)
            elif command == "list":
                for n in queue.order:
                    if args.all or queue.items[n]["status"] in ("open", "running"):
                        print(item_line(queue.items[n]))
                for message in queue.unfiled():
                    print(message_line(message))
            elif command == "board":
                board = snapshot(queue, time.time())
                if args.html:
                    write_board_page(args.html, board)
                if args.json:
                    print(json.dumps(board, ensure_ascii=False))
                elif args.html:
                    print(f"workq: wrote {args.html}")
                else:
                    print("\n".join(board_summary(board)))
            elif command == "add":
                source = queue.message_number(args.source) if args.source else None
                n = max(queue.items, default=0)
                for text in args.text:
                    n += 1
                    queue.record("add", n=n, text=text, m=source)
                    print(n)
            elif command == "nothing":
                queue.record(command, m=queue.message_number(args.number), why=args.why)
            else:
                n = queue.item_number(args.number)
                fields = {"n": n}
                if command == "move":
                    fields["after"] = 0 if args.after == "0" else queue.item_number(args.after)
                    if fields["after"] == n:
                        raise BadNumber("cannot move an item after itself")
                if command == "done" and args.note is not None:
                    fields["note"] = args.note
                if command == "drop":
                    fields["why"] = args.why
                queue.record(command, **fields)
                if command == "done":
                    pending = queue.open_items()
                    print(item_line(pending[0]) if pending else "workq: no open items")
    except BadNumber as error:
        print(f"workq: {error}", file=sys.stderr)
        return 2
    except (OSError, UnicodeError, ValueError) as error:
        print(f"workq: unreadable state: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
